[Unit]
Description=TrainMeet local meeting server
Wants=network-online.target avahi-daemon.service
After=network-online.target avahi-daemon.service mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=trainmeet-server
Group=trainmeet-server
WorkingDirectory=/var/lib/trainmeet-server
Environment=PYTHONPATH=/opt/trainmeet-server/src
ExecStart=/opt/trainmeet-server/venv/bin/python -m tmbox_gateway.local_server --external-broker --bind 0.0.0.0 --http-port 8787 --mqtt-port 1883 --state-dir /var/lib/trainmeet-server
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trainmeet-server

[Install]
WantedBy=multi-user.target
