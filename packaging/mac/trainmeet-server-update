#!/bin/sh
set -eu

# Everything below belongs to the logged-in user. Unlike the Raspberry Pi this
# needs no root, no polkit and no helper service: the server, the install
# directory and the launchd agent all run as the same person.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
INSTALL_DIR=$(dirname "$SCRIPT_DIR")
APP_DIR=$(dirname "$INSTALL_DIR")
STATE_DIR="$APP_DIR/state"
STATUS_FILE="$STATE_DIR/update-status.json"
BACKUP_DIR="$STATE_DIR/backups"
INSTALL_BACKUP="$APP_DIR/server.rollback"
LABEL="com.beahead.trainmeet-server"

# The stage names come from the shared contract in
# src/tmbox_gateway/update_contract.py, so this updater, the Raspberry Pi one
# and TrainMeet Cloud's all drive the same seven-step progress bar.
status() {
  printf '{"status":"%s","message":"%s","updated_at":"%s"}\n' \
    "$1" "$2" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATUS_FILE"
  chmod 0640 "$STATUS_FILE"
}

# A failure has to say where it happened, not just that it did.
fail_at() {
  rollback
  printf '{"status":"failed","failed_stage":"%s","message":"%s","updated_at":"%s"}\n' \
    "$1" "$2" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$STATUS_FILE"
  chmod 0640 "$STATUS_FILE"
  exit 1
}

rollback() {
  if [ -d "$INSTALL_BACKUP" ]; then
    rm -rf "$INSTALL_DIR"
    mv "$INSTALL_BACKUP" "$INSTALL_DIR"
  fi
  launchctl kickstart -k "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
}

fail() {
  fail_at installing "$1"
}

status checking "Söker efter en nyare version"

URL=https://github.com/beahead-ab/trainmeet-server/archive/refs/heads/main.tar.gz
BUILD=$(curl -fsSL https://github.com/beahead-ab/trainmeet-server/commit/main.patch | sed -n '1s/^From \([0-9a-f]\{8\}\).*/\1/p')

if [ -z "$BUILD" ]; then
  fail_at checking "GitHub lämnade ingen giltig versionsinformation"
fi

status downloading "Hämtar TrainMeet Server från GitHub"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
curl -fsSL "$URL" -o "$TMP/source.tar.gz" || fail_at downloading "Nedladdningen från GitHub misslyckades"

status verifying "Kontrollerar det hämtade paketet"
tar -tzf "$TMP/source.tar.gz" >/dev/null 2>&1 || fail_at verifying "Det hämtade arkivet gick inte att läsa"
tar -xzf "$TMP/source.tar.gz" -C "$TMP"
SOURCE=$(find "$TMP" -mindepth 1 -maxdepth 1 -type d | head -n 1)

if [ ! -x "$SOURCE/scripts/install-mac.command" ]; then
  fail_at verifying "Det hämtade paketet saknar Mac-installationen"
fi
VERSION=$(tr -d '[:space:]' < "$SOURCE/VERSION" 2>/dev/null || true)

status installing "Installerar ${VERSION:-$BUILD}"

# The database is copied with SQLite's own backup API rather than with `cp`.
# Every store in this server runs in WAL mode, so on a running server the
# main file is a 4 KiB header and the meet itself sits in trainmeet.db-wal
# beside it. Copying just the one file produced an empty database that still
# answered `ok` to an integrity check: a backup that could not be told from
# a good one until the day somebody needed it.
#
# It runs here rather than before the download for two reasons. There is no
# point backing anything up for an update that never arrives, and running it
# out of the freshly unpacked source means a fix to the backup code reaches
# installations that are still on an older version.
PYTHON="$INSTALL_DIR/venv/bin/python"
[ -x "$PYTHON" ] || PYTHON=python3
mkdir -p "$BACKUP_DIR"
# An installation from before the TMBox rename still holds tambox.db; the
# server renames it on its next start, so back up whichever one is there.
for CANDIDATE in trainmeet.db tambox.db; do
  if [ -f "$STATE_DIR/$CANDIDATE" ]; then
    PYTHONPATH="$SOURCE/src" "$PYTHON" -m tmbox_gateway.backup create \
      "$STATE_DIR/$CANDIDATE" "$BACKUP_DIR" "$(date -u +%Y%m%d-%H%M%S)" \
      || fail_at installing "Säkerhetskopieringen misslyckades, avbröt före installationen"
    break
  fi
done

rm -rf "$INSTALL_BACKUP"
cp -a "$INSTALL_DIR" "$INSTALL_BACKUP"

# install-mac.command stops the launchd agent, so this script must already be
# detached from the server process that started it.
if ! TRAINMEET_INSTALL_BUILD="$BUILD" "$SOURCE/scripts/install-mac.command" >/dev/null 2>&1; then
  fail_at installing "Installationen misslyckades, återställde föregående version"
fi

status restarting "Startar om TrainMeet Server"

# The step that was missing entirely: `complete` used to be written before the
# server had been tried even once.
status health_check "Kontrollerar att tjänsten svarar"
ATTEMPT=0
until curl -fsS http://127.0.0.1:8787/healthz >/dev/null 2>&1; do
  ATTEMPT=$((ATTEMPT + 1))
  if [ "$ATTEMPT" -ge 30 ]; then
    fail_at health_check "Servern svarade inte efter uppdateringen, återställde föregående version"
  fi
  sleep 2
done

rm -rf "$INSTALL_BACKUP"
status complete "Version ${VERSION:-$BUILD} är installerad och svarar."
