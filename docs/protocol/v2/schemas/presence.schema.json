{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainmeet.app/protocol/v2/presence.schema.json",
  "title": "TMBox presence",
  "description": "Retained närvaro. Boxens last will publicerar offline.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ]
    },
    "device_code": {
      "type": "string"
    },
    "uptime_ms": {
      "type": "integer"
    }
  }
}
