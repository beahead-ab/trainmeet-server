{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainmeet.app/protocol/v2/config.schema.json",
  "title": "TMBox station config",
  "description": "Statisk stationskonfiguration. Retained, ersätts i sin helhet.",
  "type": "object",
  "required": [
    "protocol_version",
    "config_version",
    "station",
    "tracks",
    "connections",
    "display"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "config_version": {
      "type": "integer"
    },
    "station": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_label",
          "sort_order"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          },
          "operating_point_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sort_order": {
            "type": "integer"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "connection_id",
          "other_station_code",
          "track_type",
          "dispatch_mode",
          "display_row"
        ],
        "properties": {
          "connection_id": {
            "type": "string"
          },
          "other_station_code": {
            "type": "string"
          },
          "track_type": {
            "type": "string",
            "enum": [
              "single",
              "double"
            ]
          },
          "dispatch_mode": {
            "type": "string",
            "enum": [
              "clearance",
              "direct"
            ]
          },
          "display_row": {
            "type": "integer"
          }
        }
      }
    },
    "display": {
      "type": "object",
      "required": [
        "rows",
        "cols",
        "charset"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "enum": [
            2,
            4
          ]
        },
        "cols": {
          "type": "integer",
          "enum": [
            16,
            20
          ]
        },
        "charset": {
          "type": "string",
          "enum": [
            "ascii",
            "cgram"
          ]
        }
      }
    }
  }
}
